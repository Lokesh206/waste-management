# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite with Prisma)
DATABASE_URL="file:./dev.db"

# JWT Secret Key
JWT_SECRET=supersecret_swms_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# IoT Authentication Key for Smart Bin Devices
IOT_API_KEY=swms_iot_device_secure_token_998877

# Optional Email / SMTP configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true

# Python Path for AI / Prediction Bridge
PYTHON_BIN=python

# Map Tile Configuration (Optional)
# Leave blank to use OpenStreetMap (free, zero API keys required, zero watermarks)
# If using CARTO HD basemaps, request a free key at https://carto.com/basemaps/apikey
VITE_MAP_API_KEY=

