datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  phone         String?
  password_hash String
  role          String   // citizen, collector, recycling_center, admin
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  // Relations
  wasteClassifications WasteClassification[]
  complaints           Complaint[]
  requestedCollections CollectionRequest[]   @relation("Requester")
  assignedCollections  CollectionRequest[]   @relation("AssignedCollector")
  collectionRecords    CollectionRecord[]
  recyclingRecords     RecyclingRecord[]
  notifications        Notification[]
  ecoRewards           EcoReward[]
  assignedVehicles     Vehicle[]

  @@map("users")
}

model Bin {
  id                      Int      @id @default(autoincrement())
  bin_code                String   @unique
  location_name           String
  latitude                Float
  longitude               Float
  capacity                Float    @default(100.0) // Height in cm or liters
  current_fill_percentage Float    @default(0.0)
  waste_type              String   @default("All-in-One Multi-Stream AI")
  status                  String   @default("Normal") // Normal, Moderate, Almost Full, Critical, Offline
  ward                    String?  @default("Ward 101")
  battery_level           Float?   @default(95.0)
  gas_level_ppm           Float?   @default(20.0)
  cleanliness_score       Float?   @default(95.0)
  last_collected_at       DateTime?
  is_active               Boolean  @default(true)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  // Relations
  readings           BinReading[]
  collectionRequests CollectionRequest[]
  predictions        PredictionRecord[]
  anomalies          Anomaly[]
  maintenanceTickets MaintenanceTicket[]

  @@map("bins")
}

model BinReading {
  id              Int      @id @default(autoincrement())
  bin_id          Int
  fill_percentage Float
  distance_cm     Float?
  temperature     Float?
  gas_level_ppm   Float?   @default(20.0)
  battery_level   Float?   @default(95.0)
  sensor_status   String   @default("OK")
  recorded_at     DateTime @default(now())

  // Relations
  bin Bin @relation(fields: [bin_id], references: [id], onDelete: Cascade)

  @@map("bin_readings")
}

model WasteClassification {
  id              Int      @id @default(autoincrement())
  user_id         Int
  image_path      String
  predicted_class String   // Plastic, Paper, Glass, Metal, Organic, E-Waste, Hazardous, Other
  confidence      Float
  recyclable      Boolean
  model_version   String   @default("v1.0-mobilenetv2")
  is_simulated    Boolean  @default(false)
  created_at      DateTime @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("waste_classifications")
}

model CollectionRequest {
  id                    Int       @id @default(autoincrement())
  bin_id                Int
  requested_by          Int?
  assigned_collector_id Int?
  priority              String    @default("Medium") // Low, Medium, High, Critical
  status                String    @default("Pending") // Pending, Assigned, Accepted, On the Way, Collected, Completed, Cancelled
  requested_at          DateTime  @default(now())
  assigned_at           DateTime?
  started_at            DateTime?
  completed_at          DateTime?
  notes                 String?

  // Relations
  bin               Bin                @relation(fields: [bin_id], references: [id], onDelete: Cascade)
  requester         User?              @relation("Requester", fields: [requested_by], references: [id], onDelete: SetNull)
  assignedCollector User?              @relation("AssignedCollector", fields: [assigned_collector_id], references: [id], onDelete: SetNull)
  records           CollectionRecord[]

  @@map("collection_requests")
}

model CollectionRecord {
  id                    Int      @id @default(autoincrement())
  collection_request_id Int
  collector_id          Int
  collected_quantity    Float
  unit                  String   @default("kg")
  proof_image           String?
  before_image          String?
  collection_latitude   Float?
  collection_longitude  Float?
  is_verified           Boolean  @default(true)
  fraud_flag            String?  // null if verified, or audit reason
  collected_at          DateTime @default(now())

  // Relations
  collectionRequest CollectionRequest @relation(fields: [collection_request_id], references: [id], onDelete: Cascade)
  collector         User              @relation(fields: [collector_id], references: [id], onDelete: Cascade)
  recyclingRecords  RecyclingRecord[]

  @@map("collection_records")
}

model Complaint {
  id                Int      @id @default(autoincrement())
  user_id           Int
  title             String
  category          String   @default("General Waste")
  severity          String   @default("Medium") // Low, Medium, Critical
  description       String
  image_path        String?
  latitude          Float
  longitude         Float
  address           String?
  status            String   @default("Pending") // Pending, Under Review, Assigned, Resolved, Rejected
  admin_notes       String?
  sla_deadline      DateTime?
  is_sla_breached   Boolean  @default(false)
  citizen_confirmed Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("complaints")
}

model RecyclingRecord {
  id                   Int       @id @default(autoincrement())
  batch_number         String?   // BATCH-SWMS-2026-XXXXX
  collection_record_id Int
  recycling_center_id  Int
  waste_type           String
  quantity             Float
  unit                 String    @default("kg")
  recovery_rate        Float?    @default(85.0) // % converted into reusable raw material
  status               String    @default("Pending") // Pending, Received, Processing, Recycled, Rejected
  processed_quantity   Float     @default(0.0)
  processed_at         DateTime?
  created_at           DateTime  @default(now())

  // Relations
  collectionRecord CollectionRecord @relation(fields: [collection_record_id], references: [id], onDelete: Cascade)
  recyclingCenter  User             @relation(fields: [recycling_center_id], references: [id], onDelete: Cascade)

  @@map("recycling_records")
}

model Notification {
  id                Int      @id @default(autoincrement())
  user_id           Int
  title             String
  message           String
  notification_type String   @default("system")
  is_read           Boolean  @default(false)
  created_at        DateTime @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model PredictionRecord {
  id                          Int      @id @default(autoincrement())
  bin_id                      Int
  prediction_time             DateTime @default(now())
  predicted_fill_percentage   Float
  predicted_time_to_threshold Float?   // in hours until 90%
  model_version               String   @default("v1.0-rf")
  created_at                  DateTime @default(now())

  // Relations
  bin Bin @relation(fields: [bin_id], references: [id], onDelete: Cascade)

  @@map("prediction_records")
}

model Vehicle {
  id              Int      @id @default(autoincrement())
  vehicle_code    String   @unique // TRUCK-07
  plate_number    String
  collector_id    Int?
  capacity_kg     Float    @default(1500.0)
  current_load_kg Float    @default(0.0)
  status          String   @default("Available") // Available, On Route, Maintenance, Offline
  latitude        Float    @default(12.9690)
  longitude       Float    @default(77.5920)
  speed           Float    @default(0.0)
  heading         Float    @default(0.0)
  updated_at      DateTime @updatedAt

  assignedCollector User? @relation(fields: [collector_id], references: [id], onDelete: SetNull)

  @@map("vehicles")
}

model EcoReward {
  id             Int      @id @default(autoincrement())
  user_id        Int
  points         Int
  reason         String
  reference_type String?  // complaint, classification, deposit
  reference_id   Int?
  created_at     DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("eco_rewards")
}

model Anomaly {
  id           Int      @id @default(autoincrement())
  bin_id       Int
  anomaly_type String   // Fill Spike, Sensor Drift, Battery Drain, Gas Surge
  severity     String   @default("Medium") // Low, Medium, High, Critical
  description  String
  detected_at  DateTime @default(now())
  is_resolved  Boolean  @default(false)

  bin Bin @relation(fields: [bin_id], references: [id], onDelete: Cascade)

  @@map("anomalies")
}

model MaintenanceTicket {
  id          Int       @id @default(autoincrement())
  bin_id      Int
  issue_type  String    // Battery Degradation, Ultrasonic Sensor Offline, Physical Damage
  priority    String    @default("Medium") // Low, Medium, High, Critical
  status      String    @default("Pending") // Pending, In Progress, Resolved
  description String
  created_at  DateTime  @default(now())
  resolved_at DateTime?

  bin Bin @relation(fields: [bin_id], references: [id], onDelete: Cascade)

  @@map("maintenance_tickets")
}

model Ward {
  id                     Int     @id @default(autoincrement())
  ward_number            Int     @unique
  name                   String
  target_recycling_rate  Float   @default(70.0)
  cleanliness_index      Float   @default(88.0)
  total_waste_kg         Float   @default(0.0)
  total_recycled_kg      Float   @default(0.0)

  @@map("wards")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  action      String   // LOGIN, COLLECTION_VERIFIED, FRAUD_FLAGGED, THRESHOLD_SPIKE
  entity_type String   // Bin, Collection, Complaint, Vehicle
  entity_id   Int?
  details     String?
  ip_address  String?
  created_at  DateTime @default(now())

  @@map("audit_logs")
}
